[
  {
    "plugin_id": "chmarax.herdr-nvim",
    "name": "herdr-nvim",
    "version": "1.0.0",
    "min_herdr_version": "0.7.4",
    "description": "Full-height nvim sidebar with agent annotations: toggle with one key, comment code, send to any agent.",
    "manifest_path": "/Users/jeff/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23/herdr-plugin.toml",
    "plugin_root": "/Users/jeff/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "build": [
      {
        "command": [
          "bash",
          "herdr/install.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "open-link",
        "title": "nvim sidebar: open clicked file",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" open-link"
        ]
      },
      {
        "id": "pick-file",
        "title": "nvim sidebar: open file from agent output",
        "contexts": [
          "pane"
        ],
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" pick-file"
        ]
      },
      {
        "id": "toggle",
        "title": "nvim sidebar: toggle",
        "contexts": [
          "pane",
          "workspace"
        ],
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" toggle"
        ]
      }
    ],
    "panes": [
      {
        "id": "picker",
        "title": "open file",
        "placement": "popup",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" picker"
        ]
      },
      {
        "id": "sidebar",
        "title": "nvim sidebar",
        "placement": "split",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/herdr/run.sh\" sidebar"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "file-path",
        "title": "Open in nvim sidebar",
        "pattern": "^~?[\\w.@/()\\[\\]+-]+/[\\w.@()\\[\\]+-]+\\.[A-Za-z]\\w*(?::\\d+){0,2}$",
        "action": "open-link"
      },
      {
        "id": "file-url",
        "title": "Open in nvim sidebar",
        "pattern": "^file://",
        "action": "open-link"
      }
    ],
    "source": {
      "kind": "github",
      "owner": "chmarax",
      "repo": "herdr-nvim",
      "resolved_commit": "e652ebf7b3d6713992e68a30aec588822e69fae5",
      "managed_path": "/Users/jeff/.config/herdr/plugins/github/chmarax.herdr-nvim-178624809c23",
      "installed_unix_ms": 1789073824079
    }
  },
  {
    "plugin_id": "jmarbutt.spaces-pr-status",
